generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id          String   @id @default(cuid())
  name        String
  description String?
  date        DateTime
  location    String
  
  generalPrice   Int
  vipPrice       Int
  premiumPrice   Int
  
  generalStock   Int   @default(100)
  vipStock       Int   @default(50)
  premiumStock   Int   @default(20)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tickets     Ticket[]
  
  @@index([name])
}

model Ticket {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id])
  
  attendeeName    String
  attendeeEmail   String
  
  tier            String
  price           Int
  
  qrCode          String   @unique
  status          String   @default("valid")
  
  purchasedAt     DateTime @default(now())
  usedAt          DateTime?
  
  @@index([eventId])
  @@index([qrCode])
  @@index([attendeeEmail])
}